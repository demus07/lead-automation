# ---------------------------------------------------------------- Agency Growth Engine
# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=development            # development | production
DEBUG=false

# --- Security (REQUIRED in production) ---------------------------------------------
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
COOKIE_SECURE=false                # true behind HTTPS
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=240
LOGIN_RATE_LIMIT_PER_MINUTE=10

# --- First admin (created on first start if there are no users) ---------------------
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=

# --- Database / queue ----------------------------------------------------------------
POSTGRES_USER=agency
POSTGRES_PASSWORD=agency
POSTGRES_DB=agency
# Used when running the backend outside Docker:
DATABASE_URL=postgresql+psycopg://agency:agency@localhost:5434/agency
REDIS_URL=redis://localhost:6380/0

# --- Host ports for docker compose -----------------------------------------------------
POSTGRES_HOST_PORT=5434
REDIS_HOST_PORT=6380
API_HOST_PORT=8000
FRONTEND_HOST_PORT=3000

# --- Public URLs (used for OAuth redirect URIs and CORS) --------------------------------
PUBLIC_API_URL=http://localhost:8000
PUBLIC_APP_URL=http://localhost:3000

# --- OAuth apps (optional; email integration shows "Not configured" without them) -------
# Google Cloud console → OAuth client (Web). Redirect URI: {PUBLIC_API_URL}/api/email/oauth/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Entra ID app registration. Redirect URI: {PUBLIC_API_URL}/api/email/oauth/outlook/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# --- Crawler ----------------------------------------------------------------------------
# Contact info included in the crawler User-Agent (URL or email) — good citizenship.
CRAWLER_CONTACT=
PLAYWRIGHT_ENABLED=false

# LLM, search-provider and enrichment API keys are configured in the dashboard
# (Settings → AI configuration / Integrations) and stored encrypted in the database.
