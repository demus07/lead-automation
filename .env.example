# Copy to .env and fill in. Everything here is free.

# Your contact (URL or email). Put in the crawler's User-Agent so sites know who is visiting.
CRAWLER_CONTACT=hello@alro.studio

# --- Sending email (Gmail with an App Password: myaccount.google.com/apppasswords) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
SMTP_FROM=You <you@gmail.com>

# Replies, opt-outs and bounces are read over IMAP with the same login (read-only).
# Set this only if it isn't the SMTP host with smtp. swapped for imap.
# IMAP_HOST=imap.gmail.com

# --- Drafting (any OpenAI-compatible API). Pick ONE block, then run: python check.py ---
# Groq (console.groq.com):
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=llama-3.3-70b-versatile
# Grok from xAI (console.x.ai):
#   LLM_BASE_URL=https://api.x.ai/v1
#   LLM_MODEL=grok-3-mini
# Gemini from Google AI Studio (aistudio.google.com):
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   LLM_MODEL=gemini-2.5-flash
# Ollama, local:
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=llama3.2
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
